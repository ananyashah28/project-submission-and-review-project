# Frontend .dockerignore
# Exclude files not needed in Docker image

# Dependencies (will be installed fresh)
node_modules/
.pnp/
.pnp.js

# Build output (will be built fresh)
.next/
out/
build/
dist/

# Environment files (secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage/
.nyc_output/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation
docs/
*.md
README*

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript cache
*.tsbuildinfo

# Storybook
.storybook/
storybook-static/

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# ESLint cache
.eslintcache

# Next.js
.next/
out/

# Vercel
.vercel/
