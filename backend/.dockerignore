# Backend .dockerignore
# Exclude files not needed in Docker image

# Virtual environment
venv/
.venv/
env/
.env/

# Environment files (secrets)
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation
docs/
*.md
README*

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log
logs/

# Local development
.mypy_cache/
.dmypy.json

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db
